# HostelPulse Environment Configuration Template
# Copy this file to .env to configure your local or production environment.

# Server Port (defaults to 5000 locally; Render automatically injects PORT)
PORT=5000

# Environment Mode (production / development)
NODE_ENV=production

# Database Connection URL (PostgreSQL)
# Note: If omitted or unreachable, HostelPulse automatically falls back to
# pg-mem (in-memory PostgreSQL emulator) with complete seeded demo data.
# DATABASE_URL=postgresql://user:password@hostname:5432/hostelpulse

# Authentication Secrets (Defaults are pre-configured for instant zero-config boot)
JWT_SECRET=super_secret_hostelpulse_jwt_key_2026_dev
REFRESH_TOKEN_SECRET=super_secret_hostelpulse_refresh_jwt_key_2026_dev
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_EXPIRES_IN=7d

# Food Portal Daily Cutoff Time (24-hour format: default 21:00 / 9:00 PM)
FOOD_CUTOFF_HOUR=21
FOOD_CUTOFF_MINUTE=0

# Outbound Email / SMTP (Optional: falls back to console email mock logging)
# EMAIL_HOST=smtp.ethereal.email
# EMAIL_PORT=587
# EMAIL_USER=your_smtp_user
# EMAIL_PASS=your_smtp_pass
# EMAIL_FROM="HostelPulse" <noreply@hostelpulse.edu>
