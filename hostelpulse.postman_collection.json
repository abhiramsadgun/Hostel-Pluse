{
  "info": {
    "name": "HostelPulse Foundation API",
    "description": "Postman Collection for Hostel Complaint Management System - Foundation Layer",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "System Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "http://localhost:5000/health", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["health"] }
      }
    },
    {
      "name": "Auth - Public Blocks",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "http://localhost:5000/api/v1/auth/blocks?gender=male", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "v1", "auth", "blocks"], "query": [{ "key": "gender", "value": "male" }] }
      }
    },
    {
      "name": "Auth - Login Warden",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"identifier\": \"W-MALE-101\",\n  \"password\": \"Password@123\"\n}"
        },
        "url": { "raw": "http://localhost:5000/api/v1/auth/login", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "v1", "auth", "login"] }
      }
    },
    {
      "name": "Auth - Login Student (Laminated ID)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"identifier\": \"HID-BBA-001\",\n  \"password\": \"Password@123\"\n}"
        },
        "url": { "raw": "http://localhost:5000/api/v1/auth/login", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "v1", "auth", "login"] }
      }
    },
    {
      "name": "Warden - Get Pending Students (Block Scoped)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": { "raw": "http://localhost:5000/api/v1/auth/pending-students", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "v1", "auth", "pending-students"] }
      }
    },
    {
      "name": "Warden - Approve Student",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{}" },
        "url": { "raw": "http://localhost:5000/api/v1/auth/students/5/approve", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "v1", "auth", "students", "5", "approve"] }
      }
    },
    {
      "name": "Student - Get Me & Assigned Warden",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": { "raw": "http://localhost:5000/api/v1/auth/me", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "v1", "auth", "me"] }
      }
    },
    {
      "name": "Food - Weekly Menu",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "http://localhost:5000/api/v1/food/menu", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "v1", "food", "menu"] }
      }
    },
    {
      "name": "Food - Submit Meal Preference",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }, { "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"mealDate\": \"2026-10-16\",\n  \"mealType\": \"lunch\",\n  \"selectedOptionId\": \"opt_nonveg_lunch\"\n}"
        },
        "url": { "raw": "http://localhost:5000/api/v1/food/preferences", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "v1", "food", "preferences"] }
      }
    },
    {
      "name": "Food - Mess Count Report",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": { "raw": "http://localhost:5000/api/v1/food/report?date=2026-10-16", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "v1", "food", "report"], "query": [{ "key": "date", "value": "2026-10-16" }] }
      }
    },
    {
      "name": "Notifications - Get In-App Alerts",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": { "raw": "http://localhost:5000/api/v1/notifications", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "v1", "notifications"] }
      }
    },
    {
      "name": "Admin - System Overview Stats",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": { "raw": "http://localhost:5000/api/v1/admin/stats", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "v1", "admin", "stats"] }
      }
    },
    {
      "name": "Admin - Maintenance Assignees Suggestion",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": { "raw": "http://localhost:5000/api/v1/admin/maintenance/assignees?category=Plumbing+%26+Water+Supply", "protocol": "http", "host": ["localhost"], "port": "5000", "path": ["api", "v1", "admin", "maintenance", "assignees"], "query": [{ "key": "category", "value": "Plumbing & Water Supply" }] }
      }
    }
  ]
}
